# Public Supabase credentials (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxx

# Server-side secrets (keep these in Vercel Dashboard, never commit)
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_xxx
DEEPL_API_KEY=your-deepl-key
